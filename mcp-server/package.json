{
  "name": "criptokyc-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "MCP server for AI apps (Claude, Cursor and more): sanctions screening of names (UN Security Council) and crypto wallets (OFAC, EU, UK, UN, SECO, Israel), paid per call in USDC via x402. Testnet.",
  "bin": {
    "criptokyc-mcp": "dist/cli.js"
  },
  "scripts": {
    "build": "bun build cli.ts --target=node --packages=external --outfile=dist/cli.js && chmod +x dist/cli.js",
    "prepublishOnly": "bun run build && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test:client": "bun run test-client.ts"
  },
  "dependencies": {
    "@circle-fin/x402-batching": "^4.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "^2.58.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  },
  "license": "UNLICENSED",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "x402",
    "usdc",
    "sanctions",
    "compliance",
    "arc",
    "circle"
  ]
}
